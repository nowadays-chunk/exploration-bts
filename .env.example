# MySQL 8.0.16+ connection. Use a provider CA for remote databases.
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-database-user
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=airdata
# Required for a remote database; omit when using MYSQL_SSL_DISABLED=true locally.
MYSQL_SSL_CA=C:\path\to\provider-ca.pem
# Flask should use its separate read-only MySQL account.
APP_MYSQL_USER=airdata_dashboard
APP_MYSQL_PASSWORD=replace-with-a-different-secret
# For local MySQL only: set host=localhost and uncomment this. Never use remotely.
# MYSQL_SSL_DISABLED=true
